{
  "name": "astrion",
  "description": "ASTRION — Flight-Grade Relativistic Astrodynamics, N-Body Multi-Scale Universe Simulation Engine & 3D Visualization Platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --testTimeout=300000",
    "verify": "npm run typecheck && npm run lint && npm test",
    "verify:prod": "npm run typecheck && npm run lint && npm test && npm run build",
    "fetch:horizons": "node scripts/fetch-horizons.mjs",
    "fetch:spice": "node scripts/fetch-spice.mjs",
    "fetch:textures": "node scripts/fetch-textures.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:spk": "node scripts/verify-spk.mjs",
    "audit:ui": "node scripts/ui-audit.mjs",
    "verify:nutation": "node scripts/verify-nutation.mjs",
    "format": "prettier --write .",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "^8.3.6",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "three": "^0.187.0"
  }
}
