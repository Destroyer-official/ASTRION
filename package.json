{
  "name": "astrion",
  "description": "Astronomical State & Trajectory Reconstruction Engine for Interplanetary & Orbital Navigation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm test",
    "verify:prod": "npm run typecheck && npm test && npm run build",
    "fetch:horizons": "node scripts/fetch-horizons.mjs",
    "fetch:spice": "node scripts/fetch-spice.mjs",
    "fetch:textures": "node scripts/fetch-textures.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:nutation": "node scripts/verify-nutation.mjs",
    "format": "prettier --write .",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
